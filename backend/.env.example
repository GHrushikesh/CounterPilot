# Application Settings
PROJECT_NAME=CounterPilot
ENVIRONMENT=development
API_PREFIX=/api

# Database Settings
DATABASE_URL=sqlite:///./counterpilot.db

# CORS Configuration (JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# BharatCode Model API Configuration (Official API: https://auth.bharatcode.ai/build)
BHARATCODE_API_KEY=your_bharatcode_api_key_here
BHARATCODE_API_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_TIMEOUT_SECONDS=30.0

# Optional Google Gemini Testing Configuration (https://aistudio.google.com/)
# If GEMINI_API_KEY is provided, CounterPilot temporarily routes queries to Gemini for testing.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

